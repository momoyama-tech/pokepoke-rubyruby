<h2>
  デッキレシピ
</h2>

<div class="container text-center">
  <% @deck_recipes.to_a.push(nil).each_slice(3) do |row| %>
    <div class="row">
      <% row.each do |recipe| %>
        <div class="card w-25 mb-3 me-3">
          <% if recipe.nil? %>
            <div class="card-body d-flex align-items-center justify-content-center">
              <a href="/deck_recipes/new" class="btn btn-primary">+</a>
            </div>
          <% else %>
            <img src="https://img.game8.jp/10818521/90e368c73c2b107dcd48d2d68ff5d7a1.png/show" class="card-img-top" alt="...">
            <h5 class="card-title"><%= recipe.name %></h5>
            <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
            <div class="column">
              <%= link_to "詳細", recipe, class: "btn btn-primary" %>
              <%= link_to "削除", recipe,
                method: :delete,
                data: {turbo_confirm: "本当に削除しますか？", turbo_method: :delete},
                class: "btn btn-danger" %>
          </div>
        <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
