<div class="container text-center">
  <div class="row">
    <% @deck_recipe.deck_recipes_poke_cards.each do |deck_recipes_poke_card| %>
      <div class="col-md-3 col-sm-6 col-12 mb-3"> <!-- 画面サイズに合わせてカードの幅を調整 -->
        <div class="card">
          <img src="https://img.game8.jp/10818521/90e368c73c2b107dcd48d2d68ff5d7a1.png/show" class="card-img-top" alt="...">
          <div class="card-body">
            <h5 class="card-title"><%= deck_recipes_poke_card.poke_card.name %></h5>
            <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
            <div class="d-flex justify-content-between"> <!-- ボタンを並べるためのフレックスボックス -->
              <a href="#" class="btn btn-primary">詳細</a>
              <%= link_to "削除", deck_recipe_path(@deck_recipe),
                  method: :delete,
                  data: {confirm: "本当に削除しますか？"},
                  class: "btn btn-danger" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
